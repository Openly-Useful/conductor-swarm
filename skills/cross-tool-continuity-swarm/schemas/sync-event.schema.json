{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlyuseful.org/schemas/continuity-sync-event-1.1.0.json",
  "title": "Continuity synchronization event",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_tool", "target_tool", "status", "summary"],
  "properties": {
    "id": {"type": "string"},
    "idempotency_key": {"type": "string"},
    "source_tool": {"type": "string", "minLength": 1},
    "target_tool": {"type": "string", "minLength": 1},
    "status": {"enum": ["recorded", "applied", "conflict", "blocked", "complete"]},
    "summary": {"type": "string", "minLength": 1},
    "provenance": {"type": "string"},
    "evidence": {"type": "array"}
  }
}
