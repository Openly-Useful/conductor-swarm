{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlyuseful.org/schemas/continuity-state-1.1.0.json",
  "title": "Cross-tool continuity state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project", "continuity", "context", "acceptance", "verification", "artifacts", "evidence", "sync", "audit", "idempotency"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "kind": {"const": "cross-tool-continuity"},
    "project": {"$ref": "#/$defs/project"},
    "continuity": {"$ref": "#/$defs/continuity"},
    "context": {"type": "object"},
    "acceptance": {"type": "array", "items": {"$ref": "#/$defs/acceptance"}},
    "verification": {"type": "array", "items": {"type": "object"}},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "sync": {"type": "array", "items": {"$ref": "#/$defs/sync"}},
    "audit": {"type": "object"},
    "idempotency": {"type": "object", "required": ["algorithm", "state_id"]}
  },
  "$defs": {
    "project": {"type": "object", "required": ["id", "objective"], "properties": {"id": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}, "scope": {"type": "string"}}, "additionalProperties": false},
    "continuity": {"type": "object", "required": ["phase", "status", "source_tool", "target_tool"], "properties": {"phase": {"enum": ["audit", "prepare", "sync", "switch", "review", "resume"]}, "status": {"enum": ["initialized", "ready", "blocked", "in_progress", "complete"]}, "source_tool": {"type": ["string", "null"]}, "target_tool": {"type": ["string", "null"]}}, "additionalProperties": false},
    "acceptance": {"type": "object", "required": ["id", "criterion"], "properties": {"id": {"type": "string"}, "criterion": {"type": "string"}}, "additionalProperties": true},
    "evidence": {"type": "object", "required": ["id", "kind", "summary", "provenance", "confidence"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "summary": {"type": "string"}, "provenance": {"type": "string"}, "confidence": {"enum": ["verified", "claimed", "unknown"]}}, "additionalProperties": true},
    "sync": {"type": "object", "required": ["id", "idempotency_key", "source_tool", "target_tool", "status", "summary"], "properties": {"id": {"type": "string"}, "idempotency_key": {"type": "string"}, "source_tool": {"type": "string"}, "target_tool": {"type": "string"}, "status": {"type": "string"}, "summary": {"type": "string"}}, "additionalProperties": true}
  }
}
