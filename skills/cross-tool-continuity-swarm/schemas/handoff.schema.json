{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlyuseful.org/schemas/continuity-handoff-1.1.0.json",
  "title": "Prepared continuity handoff",
  "type": "object",
  "required": ["schema_version", "project", "continuity", "context", "acceptance", "verification", "artifacts", "audit"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "project": {"type": "object"},
    "continuity": {"type": "object", "required": ["phase", "target_tool"]},
    "context": {"type": "object", "required": ["summary", "next_action"], "properties": {"summary": {"type": "string", "minLength": 1}, "next_action": {"type": "string", "minLength": 1}}},
    "acceptance": {"type": "array", "minItems": 1},
    "verification": {"type": "array", "minItems": 1},
    "artifacts": {"type": "array"},
    "audit": {"type": "object"}
  },
  "description": "The transferable portion is serialized as UTF-8 and must be no larger than 32768 bytes. No local-only values are permitted."
}
